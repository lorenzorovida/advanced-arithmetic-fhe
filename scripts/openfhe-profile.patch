 namespace lbcrypto {
 
+// AdvancedFHE profiling (scripts/openfhe-profile.patch): cumulative wall time and
+// call counts, read by the app at exit. Inline-function statics are one instance
+// across libOPENFHEpke and the executable.
+#define OPENFHE_PROFILE_TIMERS 1
+struct ProfileCounter {
+    std::atomic<uint64_t> ns{0}, calls{0};
+};
+enum ProfileSlot { PROF_ENCODE = 0, PROF_CHEBYSHEV, PROF_BOOT_STC_BITS, PROF_NSLOTS };
+inline ProfileCounter* ProfileCounters() {
+    static ProfileCounter c[PROF_NSLOTS];
+    return c;
+}
+struct ProfileScope {
+    ProfileCounter& c;
+    std::chrono::steady_clock::time_point t0 = std::chrono::steady_clock::now();
+    explicit ProfileScope(ProfileSlot s) : c(ProfileCounters()[s]) {}
+    ~ProfileScope() {
+        c.ns += std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count();
+        c.calls++;
+    }
+};
+
